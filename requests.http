### 1. Get all books
GET http://localhost:8080/library/api/books

### 2. Create a book
POST http://localhost:8080/library/api/books
Content-Type: application/json

{
  "title": "The Botany of Desire",
  "author": "Michael Pollan",
  "isbn": "9780375760396"
}

### 3. Create another book
POST http://localhost:8080/library/api/books
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "isbn": "9780132350884"
}

### 4. Get book by ID
GET http://localhost:8080/library/api/books/1

### 5. Update book
PUT http://localhost:8080/library/api/books/1
Content-Type: application/json

{
  "title": "Updated Book",
  "author": "Updated Author",
  "isbn": "9780375760396"
}

### 6. Delete book
DELETE http://localhost:8080/library/api/books/2

### 7. Get all members
GET http://localhost:8080/library/api/members

### 8. Create member 1
POST http://localhost:8080/library/api/members
Content-Type: application/json

{
  "name": "Ahmed",
  "email": "ahmed@example.com"
}

### 9. Create member 2
POST http://localhost:8080/library/api/members
Content-Type: application/json

{
  "name": "Mohamed",
  "email": "mohamed@example.com"
}

### 10. Get all loans
GET http://localhost:8080/library/api/loans

### 11. Borrow book 1 for member 1
POST http://localhost:8080/library/api/loans
Content-Type: application/json

{
  "bookId": 1,
  "memberId": 1
}

### 12. Return loan 1
POST http://localhost:8080/library/api/loans/1/return

### 13. Blank title - should return 400
POST http://localhost:8080/library/api/books
Content-Type: application/json

{
  "title": "",
  "author": "Author",
  "isbn": "9780375760396"
}

### 14. Invalid ISBN - should return 400
POST http://localhost:8080/library/api/books
Content-Type: application/json

{
  "title": "Test Book",
  "author": "Author",
  "isbn": "123"
}

### 15. Invalid member email - should return 400
POST http://localhost:8080/library/api/members
Content-Type: application/json

{
  "name": "Test Member",
  "email": "invalid-email"
}

### 16. Unknown book - should return 404
GET http://localhost:8080/library/api/books/9999

### 17. Unknown loan - should return 404
POST http://localhost:8080/library/api/loans/9999/return

### 18. Borrow the same book again - should return 409
POST http://localhost:8080/library/api/loans
Content-Type: application/json

{
  "bookId": 1,
  "memberId": 1
}

###
GET http://localhost:8080/library/api/books